# Restore Probe – secrets. File: /etc/restore-probe/.env, mode 600, owner root.
# Fill these in yourself; the YAML references them as ${NAME}. See README → "Secrets" for where to get each
# value and how to rotate it.

# Home Assistant: long-lived access token (profile → Security → Long-lived access tokens → "Restore Probe")
HA_TOKEN=

# Encryption key of Home Assistant's backups (emergency kit, format XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX)
HA_BACKUP_KEY=

# restic
RESTIC_REPOSITORY=/mnt/nas/system-backups/restic
RESTIC_PASSWORD=

# Optional: minutes to wait for Docker when it is currently stopped (default 45)
# DOCKER_WAIT_MIN=45
